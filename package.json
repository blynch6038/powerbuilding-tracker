{
  "name": "powerbuilding-tracker",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run test:program && npm run test:recommendations && node scripts/test-substitutions.mjs && node scripts/test-notes.mjs && node scripts/test-performance.mjs && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:program": "node scripts/validate-program.mjs",
    "test:recommendations": "node scripts/test-recommendations.mjs",
    "test:notes": "node scripts/test-notes.mjs",
    "test:performance": "node scripts/test-performance.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.0",
    "dexie": "4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.8.3",
    "vite": "6.3.0",
    "vite-plugin-pwa": "1.0.0"
  }
}
