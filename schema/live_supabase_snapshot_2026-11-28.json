      {
        "name": "normalize_set_completion",
        "schema": "public",
        "language": "plpgsql",
        "definition": "CREATE OR REPLACE FUNCTION public.normalize_set_completion()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nbegin\n if new.done then\n  new.skipped:=false;\n  if tg_op='UPDATE' and old.done then new.completed_at:=coalesce(old.completed_at,new.completed_at); end if;\n else new.completed_at:=null; end if;\n return new;\nend $function$\n",
        "volatility": "v",
        "security_definer": false,
        "identity_arguments": "",
        "search_path_config": [
          "search_path=\"\""
        ]
