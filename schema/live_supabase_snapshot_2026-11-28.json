      {
        "name": "register_invited_user",
        "schema": "public",
        "language": "plpgsql",
        "definition": "CREATE OR REPLACE FUNCTION public.register_invited_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nbegin\n insert into public.members(user_id) values(new.id) on conflict do nothing;\n return new;\nend $function$\n",
